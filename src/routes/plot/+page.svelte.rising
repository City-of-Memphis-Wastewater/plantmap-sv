<!-- src/routes/plot/+page.svelte -->

<script lang="ts">
    import { onMount } from 'svelte';

    import {
        DEFAULT_TAGS,
        DEFAULT_DAYS,
        DEFAULT_DATAPOINT_COUNT,
        DEFAULT_FUNCTION_TYPE,
        MAX_TAGS,
        MAX_DAYS,
        MAX_DATAPOINT_COUNT,
        MAX_SECONDS_BETWEEN_POINTS,
        SUPPORTED_FUNCTION_TYPES,
        PLOT_API_PATH
    } from '$lib/plot/context';

    import { parsePlotUrl, buildPlotSearchParams } from '$lib/plot/url';

    import type {
        PlotOptions,
        ResolvedPlotRequest
    } from '$lib/plot/types';

    // -------------------------------------------------------------------------
    // Types
    // -------------------------------------------------------------------------

    interface TelemetrySample {
        timestamp: string | number;
        value: number | null;
        quality?: string;
    }

    interface PlotResponse {
        request?: Partial<ResolvedPlotRequest> & Record<string, unknown>;
        values: Record<string, TelemetrySample[]>;
        error?: string;
        message?: string;
    }

    interface PlotSeries {
        name: string;
        type: 'line';
        showSymbol: boolean;
        connectNulls: boolean;
        data: Array<[number, number | null]>;
    }

    // -------------------------------------------------------------------------
    // State
    // -------------------------------------------------------------------------

    let chartElement: HTMLDivElement;

    let tagsInput = $state(DEFAULT_TAGS.join(','));
    let days = $state(String(DEFAULT_DAYS));
    let datapointCount = $state(String(DEFAULT_DATAPOINT_COUNT));
    let secondsBetweenPoints = $state('');
    let functionType = $state(DEFAULT_FUNCTION_TYPE);

    let startTime = $state('');
    let endTime = $state('');

    // A displayed default is not necessarily an explicitly requested value.
    let daysExplicit = $state(false);

    let loading = $state(false);
    let chartReady = $state(false);
    let error = $state('');
    let status = $state('');

    let resultCount = $state(0);
    let lastUpdated = $state('');

    let chart: import('echarts').ECharts | undefined;
    let echartsModule: typeof import('echarts') | undefined;

    let requestSequence = 0;

    // -------------------------------------------------------------------------
    // Form helpers
    // -------------------------------------------------------------------------

    /**
     * Convert a datetime-local field value to an ISO timestamp.
     *
     * datetime-local has no timezone. JavaScript interprets its value
     * in the browser's local timezone; toISOString() converts it to UTC.
     */
    function toIsoTimestamp(value: string): string | undefined {
        if (!value.trim()) {
            return undefined;
        }

        const date = new Date(value);

        if (!Number.isFinite(date.getTime())) {
            throw new Error('Enter a valid date and time.');
        }

        return date.toISOString();
    }

    /**
     * Convert an ISO timestamp to a datetime-local field value.
     */
    function toLocalDateTime(value: string | undefined): string {
        if (!value) {
            return '';
        }

        const date = new Date(value);

        if (!Number.isFinite(date.getTime())) {
            return '';
        }

        const pad = (value: number) => String(value).padStart(2, '0');

        return (
            `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}` +
            `T${pad(date.getHours())}:${pad(date.getMinutes())}`
        );
    }

    /**
     * Collect user input without independently resolving the time range
     * or sampling interval. The shared request logic remains authoritative.
     */
    function collectPlotOptions(): PlotOptions {
        const tags = tagsInput
            .split(',')
            .map((tag) => tag.trim())
            .filter(Boolean);

        if (tags.length === 0) {
            throw new Error('Enter at least one sensor tag.');
        }

        if (tags.length > MAX_TAGS) {
            throw new Error(`Enter no more than ${MAX_TAGS} sensor tags.`);
        }

        const start = toIsoTimestamp(startTime);
        const end = toIsoTimestamp(endTime);

        const options: PlotOptions = {
            tags,
            functionType
        };

        if (start !== undefined) {
            options.start = start;
        }

        if (end !== undefined) {
            options.end = end;
        }

        // Include days only when explicitly chosen.
        // Otherwise, the shared resolver applies its own default semantics.
        if (daysExplicit && days.trim() !== '') {
            const parsedDays = Number(days);

            if (
                !Number.isFinite(parsedDays) ||
                parsedDays <= 0 ||
                parsedDays > MAX_DAYS
            ) {
                throw new Error(
                    `Days must be greater than 0 and no greater than ${MAX_DAYS}.`
                );
            }

            options.days = parsedDays;
        }

        const hasDatapointCount = datapointCount.trim() !== '';
        const hasExplicitInterval = secondsBetweenPoints.trim() !== '';

        if (hasDatapointCount && hasExplicitInterval) {
            throw new Error(
                'Choose either a target datapoint count or a sampling interval, not both.'
            );
        }

        if (hasDatapointCount) {
            const parsedCount = Number(datapointCount);

            if (
                !Number.isInteger(parsedCount) ||
                parsedCount < 1 ||
                parsedCount > MAX_DATAPOINT_COUNT
            ) {
                throw new Error(
                    `Datapoint count must be an integer between 1 and ${MAX_DATAPOINT_COUNT}.`
                );
            }

            options.datapointCount = parsedCount;
        } else if (hasExplicitInterval) {
            const parsedInterval = Number(secondsBetweenPoints);

            if (
                !Number.isFinite(parsedInterval) ||
                parsedInterval <= 0 ||
                parsedInterval > MAX_SECONDS_BETWEEN_POINTS
            ) {
                throw new Error(
                    `Sampling interval must be greater than 0 and no greater than ${MAX_SECONDS_BETWEEN_POINTS} seconds.`
                );
            }

            options.secondsBetweenPoints = parsedInterval;
        }

        return options;
    }

    /**
     * Load the form from the URL.
     *
     * URL parsing belongs to url.ts. This function only maps the parsed
     * options into UI state.
     */
    function loadOptionsFromUrl(): PlotOptions {
        const options = parsePlotUrl(
            new URLSearchParams(window.location.search)
        );

        tagsInput = options.tags.join(',');
        days = String(options.days ?? DEFAULT_DAYS);
        daysExplicit = options.days !== undefined;

        datapointCount =
            options.datapointCount === undefined
                ? ''
                : String(options.datapointCount);

        secondsBetweenPoints =
            options.secondsBetweenPoints === undefined
                ? ''
                : String(options.secondsBetweenPoints);

        functionType = options.functionType ?? DEFAULT_FUNCTION_TYPE;

        startTime = toLocalDateTime(options.start);
        endTime = toLocalDateTime(options.end);

        // If neither sampling option was supplied, display the default target.
        if (
            options.datapointCount === undefined &&
            options.secondsBetweenPoints === undefined
        ) {
            datapointCount = String(DEFAULT_DATAPOINT_COUNT);
        }

        return options;
    }

    // -------------------------------------------------------------------------
    // ECharts helpers
    // -------------------------------------------------------------------------

    function timestampToMilliseconds(timestamp: string | number): number {
        if (typeof timestamp === 'number') {
            // EDS data may represent timestamps in seconds or milliseconds.
            return timestamp < 1_000_000_000_000
                ? timestamp * 1000
                : timestamp;
        }

        return Date.parse(timestamp);
    }

    function buildSeries(
        values: Record<string, TelemetrySample[]>
    ): PlotSeries[] {
        return Object.entries(values).map(([tag, samples]) => ({
            name: tag,
            type: 'line',
            showSymbol: false,
            connectNulls: false,
            data: samples.map((sample) => [
                timestampToMilliseconds(sample.timestamp),
                sample.value
            ])
        }));
    }

    function updateChart(response: PlotResponse): void {
        if (!chart) {
            return;
        }

        const series = buildSeries(response.values ?? []);

        resultCount = series.reduce(
            (total, item) => total + item.data.length,
            0
        );

        chart.setOption(
            {
                legend: {
                    type: 'scroll',
                    top: 8,
                    left: 12,
                    right: 12,
                    data: series.map((item) => item.name)
                },
                series
            },
            {
                notMerge: true,
                lazyUpdate: true
            }
        );

        lastUpdated = new Date().toLocaleString();
        status = `Loaded ${resultCount.toLocaleString()} readings.`;
    }

    // -------------------------------------------------------------------------
    // Data loading
    // -------------------------------------------------------------------------

    async function loadTrend(): Promise<void> {
        const sequence = ++requestSequence;

        loading = true;
        error = '';
        status = 'Loading telemetry…';

        try {
            const options = collectPlotOptions();
            const params = buildPlotSearchParams(options);

            // Keep the browser URL shareable and in sync with the submitted form.
            const query = params.toString();
            const nextUrl = query
                ? `${window.location.pathname}?${query}`
                : window.location.pathname;

            window.history.replaceState({}, '', nextUrl);

            const response = await fetch(`${PLOT_API_PATH}?${query}`);

            if (!response.ok) {
                const body = await response.text();
                throw new Error(
                    body || `Plot request failed (${response.status}).`
                );
            }

            const result = (await response.json()) as PlotResponse;

            // Ignore results from older requests that completed late.
            if (sequence !== requestSequence) {
                return;
            }

            if (result.error) {
                throw new Error(result.error);
            }

            if (!result.values || typeof result.values !== 'object') {
                throw new Error('The plot API returned an invalid response.');
            }

            updateChart(result);
        } catch (cause) {
            if (sequence !== requestSequence) {
                return;
            }

            error =
                cause instanceof Error
                    ? cause.message
                    : 'Unable to load telemetry.';

            status = '';
        } finally {
            if (sequence === requestSequence) {
                loading = false;
            }
        }
    }

    function handleSubmit(event: SubmitEvent): void {
        event.preventDefault();
        void loadTrend();
    }

    // -------------------------------------------------------------------------
    // Lifecycle
    // -------------------------------------------------------------------------

    onMount(() => {
        let disposed = false;
        let resizeObserver: ResizeObserver | undefined;

        async function initialize(): Promise<void> {
            try {
                // Load ECharts only in the browser, after the chart element exists.
                echartsModule = await import('echarts');

                if (disposed) {
                    return;
                }

                chart = echartsModule.init(chartElement);

                chart.setOption({
                    animation: false,
                    grid: {
                        top: 64,
                        right: 28,
                        bottom: 76,
                        left: 68,
                        containLabel: true
                    },
                    tooltip: {
                        trigger: 'axis',
                        axisPointer: {
                            type: 'cross'
                        }
                    },
                    legend: {
                        type: 'scroll',
                        top: 8
                    },
                    xAxis: {
                        type: 'time',
                        boundaryGap: false,
                        axisLabel: {
                            hideOverlap: true
                        }
                    },
                    yAxis: {
                        type: 'value',
                        scale: true,
                        splitLine: {
                            show: true
                        }
                    },
                    dataZoom: [
                        {
                            type: 'inside',
                            filterMode: 'none'
                        },
                        {
                            type: 'slider',
                            filterMode: 'none',
                            bottom: 12
                        }
                    ],
                    series: []
                });

                chartReady = true;

                resizeObserver = new ResizeObserver(() => {
                    chart?.resize();
                });

                resizeObserver.observe(chartElement);

                // Load URL parameters only after the chart is ready.
                loadOptionsFromUrl();
                await loadTrend();
            } catch (cause) {
                if (!disposed) {
                    error =
                        cause instanceof Error
                            ? cause.message
                            : 'Unable to initialize the plot.';
                }
            }
        }

        void initialize();

        return () => {
            disposed = true;
            requestSequence++;

            resizeObserver?.disconnect();
            chart?.dispose();

            chart = undefined;
            chartReady = false;
        };
    });
</script>

<svelte:head>
    <title>Historical Telemetry Plot</title>
    <meta
        name="description"
        content="Explore historical Ovation EDS telemetry."
    />
</svelte:head>

<main class="plot-page">
    <header class="page-header">
        <div>
            <h1>Historical Telemetry</h1>
            <p>
                Plot sensor readings over a selected time range.
            </p>
        </div>

        <div class="header-status" aria-live="polite">
            {#if loading}
                <span class="status-indicator loading"></span>
                Loading
            {:else if error}
                <span class="status-indicator failed"></span>
                Error
            {:else if chartReady}
                <span class="status-indicator ready"></span>
                Ready
            {/if}
        </div>
    </header>

    <form class="plot-controls" onsubmit={handleSubmit}>
        <div class="field field-tags">
            <label for="tags">Sensor tags</label>
            <input
                id="tags"
                type="text"
                bind:value={tagsInput}
                placeholder="M100FI, FI8001"
                autocomplete="off"
                required
            />
            <small>Separate multiple tags with commas.</small>
        </div>

        <div class="field">
            <label for="start">Start time</label>
            <input
                id="start"
                type="datetime-local"
                bind:value={startTime}
            />
        </div>

        <div class="field">
            <label for="end">End time</label>
            <input
                id="end"
                type="datetime-local"
                bind:value={endTime}
            />
        </div>

        <div class="field field-days">
            <label for="days">Duration (days)</label>
            <input
                id="days"
                type="number"
                min="0.01"
                max={MAX_DAYS}
                step="any"
                bind:value={days}
                oninput={() => (daysExplicit = true)}
            />
            <small>
                Used when the range needs a duration.
            </small>
        </div>

        <div class="field">
            <label for="datapoints">Target data points</label>
            <input
                id="datapoints"
                type="number"
                min="1"
                max={MAX_DATAPOINT_COUNT}
                step="1"
                bind:value={datapointCount}
                oninput={() => {
                    if (datapointCount.trim() !== '') {
                        secondsBetweenPoints = '';
                    }
                }}
            />
        </div>

        <div class="field">
            <label for="interval">Seconds between points</label>
            <input
                id="interval"
                type="number"
                min="1"
                max={MAX_SECONDS_BETWEEN_POINTS}
                step="1"
                bind:value={secondsBetweenPoints}
                oninput={() => {
                    if (secondsBetweenPoints.trim() !== '') {
                        datapointCount = '';
                    }
                }}
            />
        </div>

        <div class="field">
            <label for="function">Aggregation</label>
            <select id="function" bind:value={functionType}>
                {#each SUPPORTED_FUNCTION_TYPES as option}
                    <option value={option}>{option}</option>
                {/each}
            </select>
        </div>

        <div class="form-actions">
            <button
                type="submit"
                class="primary-button"
                disabled={loading || !chartReady}
            >
                {loading ? 'Loading…' : 'Load plot'}
            </button>

            <button
                type="button"
                class="secondary-button"
                onclick={() => {
                    tagsInput = DEFAULT_TAGS.join(',');
                    days = String(DEFAULT_DAYS);
                    daysExplicit = false;
                    datapointCount = String(DEFAULT_DATAPOINT_COUNT);
                    secondsBetweenPoints = '';
                    functionType = DEFAULT_FUNCTION_TYPE;
                    startTime = '';
                    endTime = '';
                }}
                disabled={loading}
            >
                Reset
            </button>
        </div>
    </form>

    {#if error}
        <section class="error-banner" role="alert">
            <strong>Unable to load plot</strong>
            <p>{error}</p>
        </section>
    {/if}

    <section class="chart-panel" aria-label="Historical telemetry chart">
        <div class="chart-toolbar">
            <div>
                <h2>Trend</h2>
                <p class="chart-status" aria-live="polite">
                    {status || 'Configure the plot and load telemetry.'}
                </p>
            </div>

            {#if resultCount > 0}
                <div class="chart-summary">
                    <strong>{resultCount.toLocaleString()}</strong>
                    <span>readings</span>
                </div>
            {/if}
        </div>

        <div class="chart-container">
            <div
                class="chart"
                bind:this={chartElement}
                aria-label="Time-series chart of sensor readings"
            ></div>

            {#if loading && chartReady}
                <div class="chart-overlay">
                    <span class="spinner"></span>
                    <span>Fetching telemetry…</span>
                </div>
            {:else if !loading && resultCount === 0 && !error && chartReady}
                <div class="chart-empty">
                    <strong>No readings loaded</strong>
                    <span>Choose sensors and a time range, then load the plot.</span>
                </div>
            {/if}
        </div>

        {#if lastUpdated}
            <footer class="chart-footer">
                Updated {lastUpdated}
            </footer>
        {/if}
    </section>
</main>

<style>
    :global(*) {
        box-sizing: border-box;
    }

    :global(body) {
        margin: 0;
    }

    .plot-page {
        --surface: var(--color-surface, #ffffff);
        --surface-muted: var(--color-surface-secondary, #f5f7fa);
        --border: var(--color-border, #dce2e9);
        --text: var(--color-text, #17212f);
        --muted: var(--color-text-secondary, #647184);
        --accent: var(--color-primary, #2563eb);

        width: min(100%, 1800px);
        margin: 0 auto;
        padding: 28px;
        color: var(--text);
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        margin-bottom: 24px;
    }

    h1,
    h2,
    p {
        margin-top: 0;
    }

    h1 {
        margin-bottom: 6px;
        font-size: clamp(1.6rem, 3vw, 2.1rem);
        font-weight: 700;
        letter-spacing: -0.035em;
    }

    .page-header p,
    .chart-status {
        margin-bottom: 0;
        color: var(--muted);
    }

    .header-status {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 12px;
        border: 1px solid var(--border);
        border-radius: 999px;
        font-size: 0.85rem;
        white-space: nowrap;
    }

    .status-indicator {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #9ca3af;
    }

    .status-indicator.loading {
        background: #d97706;
    }

    .status-indicator.ready {
        background: #16a34a;
    }

    .status-indicator.failed {
        background: #dc2626;
    }

    .plot-controls {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 18px;
        padding: 22px;
        margin-bottom: 24px;
        border: 1px solid var(--border);
        border-radius: 14px;
        background: var(--surface);
    }

    .field {
        display: flex;
        min-width: 0;
        flex-direction: column;
        gap: 7px;
    }

    .field-tags {
        grid-column: span 2;
    }

    .field-days small,
    .field small {
        color: var(--muted);
        font-size: 0.78rem;
        line-height: 1.4;
    }

    label {
        font-size: 0.88rem;
        font-weight: 600;
    }

    input,
    select {
        width: 100%;
        min-width: 0;
        min-height: 42px;
        padding: 9px 11px;
        border: 1px solid var(--border);
        border-radius: 7px;
        background: var(--surface);
        color: var(--text);
        font: inherit;
        font-size: 0.9rem;
    }

    input:focus,
    select:focus {
        outline: 2px solid var(--accent);
        outline-offset: 1px;
    }

    .form-actions {
        grid-column: 1 / -1;
        display: flex;
        align-items: center;
        gap: 10px;
        padding-top: 4px;
    }

    button {
        min-height: 42px;
        padding: 9px 17px;
        border: 1px solid transparent;
        border-radius: 7px;
        font: inherit;
        font-size: 0.9rem;
        font-weight: 600;
        cursor: pointer;
    }

    button:disabled {
        opacity: 0.55;
        cursor: not-allowed;
    }

    .primary-button {
        background: var(--accent);
        color: white;
    }

    .primary-button:hover:not(:disabled) {
        filter: brightness(0.94);
    }

    .secondary-button {
        border-color: var(--border);
        background: var(--surface);
        color: var(--text);
    }

    .chart-panel {
        overflow: hidden;
        border: 1px solid var(--border);
        border-radius: 14px;
        background: var(--surface);
    }

    .chart-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        padding: 20px 22px;
        border-bottom: 1px solid var(--border);
    }

    .chart-toolbar h2 {
        margin-bottom: 5px;
        font-size: 1.1rem;
    }

    .chart-status {
        font-size: 0.85rem;
    }

    .chart-summary {
        display: flex;
        align-items: baseline;
        gap: 6px;
        white-space: nowrap;
    }

    .chart-summary strong {
        font-size: 1.25rem;
    }

    .chart-summary span {
        color: var(--muted);
        font-size: 0.8rem;
    }

    .chart-container {
        position: relative;
        min-height: 420px;
    }

    .chart {
        width: 100%;
        height: min(62vh, 650px);
        min-height: 420px;
    }

    .chart-overlay,
    .chart-empty {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 12px;
        background: color-mix(in srgb, var(--surface) 82%, transparent);
        color: var(--muted);
        pointer-events: none;
    }

    .chart-empty strong {
        color: var(--text);
    }

    .chart-empty span {
        text-align: center;
        padding: 0 20px;
        font-size: 0.9rem;
    }

    .spinner {
        width: 28px;
        height: 28px;
        border: 3px solid var(--border);
        border-top-color: var(--accent);
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    .chart-footer {
        padding: 12px 22px;
        border-top: 1px solid var(--border);
        color: var(--muted);
        font-size: 0.78rem;
    }

    .error-banner {
        padding: 15px 18px;
        margin-bottom: 20px;
        border: 1px solid #fecaca;
        border-radius: 10px;
        background: #fef2f2;
        color: #991b1b;
    }

    .error-banner strong {
        display: block;
        margin-bottom: 5px;
    }

    .error-banner p {
        margin-bottom: 0;
        overflow-wrap: anywhere;
    }

    @keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    @media (max-width: 1000px) {
        .plot-page {
            padding: 20px;
        }

        .plot-controls {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .field-tags {
            grid-column: 1 / -1;
        }
    }

    @media (max-width: 600px) {
        .plot-page {
            padding: 14px;
        }

        .page-header {
            flex-direction: column;
            gap: 12px;
        }

        .plot-controls {
            grid-template-columns: minmax(0, 1fr);
            padding: 16px;
            gap: 15px;
        }

        .field-tags {
            grid-column: auto;
        }

        .form-actions {
            flex-wrap: wrap;
        }

        .chart-toolbar {
            align-items: flex-start;
            padding: 16px;
        }

        .chart {
            height: 440px;
            min-height: 360px;
        }

        .chart-container {
            min-height: 360px;
        }
    }
</style>
